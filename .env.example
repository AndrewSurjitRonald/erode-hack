# Database connection string for Prisma (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public

# ----------------------------------------------------------------------------
# Option 1: Docker Compose (Easiest zero-configuration local setup)
# Run: `docker compose up -d`
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erodehack"

# ----------------------------------------------------------------------------
# Option 2: Local Mac Homebrew Postgres (uses your macOS username, no password)
# Check your username with `whoami` and run `createdb erodehack`
# Example: DATABASE_URL="postgresql://andrew@localhost:5432/erodehack"
# ----------------------------------------------------------------------------
# DATABASE_URL="postgresql://<your-laptop-username>@localhost:5432/erodehack"

# ----------------------------------------------------------------------------
# Option 3: Standard Postgres with password (Linux / Windows / Mac Postgres.app)
# ----------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/erodehack"

# ----------------------------------------------------------------------------
# Option 4: Free Cloud Postgres (Supabase, Neon, Railway)
# ----------------------------------------------------------------------------
# DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/erodehack?sslmode=require"

# ----------------------------------------------------------------------------
# Optional: Groq API key for AI-generated step-by-step solutions and
# misconception diagnosis on the practice page (app/api/explain/route.ts).
# Without it, the app falls back to the static per-topic explanations in
# lib/explanations.ts — everything else works with no key set.
# Get a free key at https://console.groq.com
# ----------------------------------------------------------------------------
# GROQ_API_KEY="gsk_..."
